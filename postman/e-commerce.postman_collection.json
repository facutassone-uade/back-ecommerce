{
	"info": {
		"name": "e-commerce",
		"description": "Colección de requests para la API REST del proyecto e-commerce (Spring Boot). Usa la variable {{baseUrl}} (por defecto http://localhost:8080).",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
