			"name": "Auth",
			"item": [
				{
					"name": "Register (customer)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"const body = pm.response.json();",
									"pm.collectionVariables.set('authToken', body.token);"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"Facundo\",\n    \"lastName\": \"Tassone\",\n    \"nationalId\": 123456789,\n    \"email\": \"ftassone@uade.com.ar\",\n    \"phone\": 12345678,\n    \"address\": {\n        \"street\": \"Av siempre viva 742\",\n        \"city\": \"CABA\",\n        \"zipCode\": \"1000\",\n        \"country\": \"Argentina\"\n    },\n    \"username\": \"ftassone\",\n    \"password\": \"1234\"\n}"
						},
